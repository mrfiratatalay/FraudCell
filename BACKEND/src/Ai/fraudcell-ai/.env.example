# ai-service: environment as docker-compose.yml sets it (BACKEND/docker-compose.yml).
# Secrets are placeholders; the real values come from BACKEND/.env. Hostnames are compose service names;
# use localhost and the published ports to run the service on its own.

AI_DB_HOST=postgres-ai
AI_DB_NAME=fraudcell_ai
AI_DB_PASSWORD=change_me_ai_db_password
AI_DB_PORT=5432
AI_DB_USER=ai_app
GEMINI_API_KEY=
INTERNAL_API_TOKEN=local-development-only
RABBITMQ_HOST=rabbitmq
RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_USER_NAME=fraudcell
