# edge-gateway: environment as docker-compose.yml sets it (BACKEND/docker-compose.yml).
# Secrets are placeholders; the real values come from BACKEND/.env. Hostnames are compose service names;
# use localhost and the published ports to run the service on its own.

ASPNETCORE_ENVIRONMENT=Development
Jwt__MetadataAddress=http://identity-service:8080/.well-known/openid-configuration
ReverseProxy__Clusters__ai__Destinations__ai-service__Address=http://ai-service:8000/
ReverseProxy__Clusters__gamification__Destinations__gamification-service__Address=http://gamification-service:8080/
ReverseProxy__Clusters__identity__Destinations__identity-service__Address=http://identity-service:8080/
ReverseProxy__Clusters__notification__Destinations__notification-service__Address=http://notification-service:8080/
ReverseProxy__Clusters__transaction__Destinations__transaction-service__Address=http://transaction-service:8080/
ReverseProxy__Clusters__web__Destinations__web__Address=http://web:8080/
