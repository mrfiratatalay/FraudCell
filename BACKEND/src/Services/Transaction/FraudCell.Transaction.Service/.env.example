# transaction-service: environment as docker-compose.yml sets it (BACKEND/docker-compose.yml).
# Secrets are placeholders; the real values come from BACKEND/.env. Hostnames are compose service names;
# use localhost and the published ports to run the service on its own.

ASPNETCORE_ENVIRONMENT=Development
CaseClosure__Delay=2.00:00:00
CaseClosure__PollInterval=00:05:00
ConnectionStrings__TransactionDb=Host=postgres-transaction;Port=5432;Database=fraudcell_transaction;Username=transaction_app;Password=change_me_transaction_db_password;Minimum Pool Size=0;Maximum Pool Size=15
Jwt__MetadataAddress=http://identity-service:8080/.well-known/openid-configuration
RabbitMq__Host=rabbitmq
RabbitMq__Password=change_me_rabbitmq_password
RabbitMq__UserName=fraudcell
