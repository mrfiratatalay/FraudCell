# identity-service: environment as docker-compose.yml sets it (BACKEND/docker-compose.yml).
# Secrets are placeholders; the real values come from BACKEND/.env. Hostnames are compose service names;
# use localhost and the published ports to run the service on its own.

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__IdentityDb=Host=postgres-identity;Port=5432;Database=fraudcell_identity;Username=identity_app;Password=change_me_identity_db_password;Minimum Pool Size=0;Maximum Pool Size=15
Jwt__PrivateKeyPath=/keys/identity/private.pem
Jwt__PublicKeyPath=/keys/identity/public.pem
RabbitMq__Host=rabbitmq
RabbitMq__Password=change_me_rabbitmq_password
RabbitMq__UserName=fraudcell
Seed__AdminEmail=admin@fraudcell.local
Seed__AdminPassword=ChangeMe123!
