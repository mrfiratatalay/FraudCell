# FraudCell local Docker Compose ortam degiskenleri.
# Gercek degerlerle doldurup `.env` olarak kaydedin (`.env` .gitignore'da, repoya girmez).
#
#   cp .env.example .env

# --- Genel ---
# Development: RsaKeyProvider anahtar bulunamazsa gecici cift uretip diske yazar.
# Production/demo icin onceden uretilmis anahtar zorunludur (bkz. Security/RsaKeyProvider.cs).
ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL ---
# Servis basina ayri PostgreSQL container'i, ayri ozel ag ve ayri login rolu.
# Her rol yalnizca kendi database'ine CONNECT edebilir; bkz.
# docker/postgres/init-multiple-databases.sh.
IDENTITY_DB_PASSWORD=change_me_identity
TRANSACTION_DB_PASSWORD=change_me_transaction
GAMIFICATION_DB_PASSWORD=change_me_gamification
AI_DB_PASSWORD=change_me_ai

# Superuser; yalnizca ilk acilista database/rol olusturmak icin kullanilir.
# Hicbir uygulama servisi bu hesapla baglanmaz.
POSTGRES_ADMIN_PASSWORD=change_me_postgres_admin

# --- RabbitMQ ---
RABBITMQ_USER=fraudcell
RABBITMQ_PASSWORD=change_me_rabbitmq

# Internal AI maintenance endpoints. Do not reuse this outside local/demo.
AI_INTERNAL_API_TOKEN=change_me_ai_internal

# --- Gemini (SADECE aciklama anlatisi; risk skorlama harici LLM KULLANMAZ) ---
# Bos birakilirsa aciklama endpoint'i deterministik ozete duser (özellik opsiyonel).
# Anahtari asla repoya commit'lemeyin. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Deterministic local/demo administrator. Replace outside local development.
SEED_ADMIN_EMAIL=admin@fraudcell.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Demo staff created by the demo-seed job (scripts/demo.py): analyst.kart, analyst.hesap,
# analyst.aklama, analyst.davranis and supervisor @fraudcell.local. Local/demo only.
DEMO_STAFF_PASSWORD=Demo1234!

# A decided case closes after this delay (d.hh:mm:ss; default 2 days). CI's browser tests
# set a few seconds so the customer can rate the closed case.
# CASE_CLOSURE_DELAY=2.00:00:00
# CASE_CLOSURE_POLL_INTERVAL=00:05:00
